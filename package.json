{
  "name": "subtitle-tools",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "check:versions": "node scripts/check-versions.mjs",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:release": "node --test scripts/release.test.mjs",
    "release:win": "node scripts/build-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "clean:outputs": "node scripts/clean-outputs.mjs",
    "clean:release-cache": "node scripts/clean-outputs.mjs --release-cache",
    "disk:report": "node scripts/report-disk-usage.mjs",
    "tauri": "tauri",
    "benchmark": "node --expose-gc scripts/benchmark.mjs --phase=current && node scripts/benchmark-browser.mjs && node scripts/benchmark-report.mjs",
    "benchmark:engine": "node --expose-gc scripts/benchmark.mjs --phase=current",
    "benchmark:browser": "node scripts/benchmark-browser.mjs",
    "benchmark:report": "node scripts/benchmark-report.mjs"
  },
  "dependencies": {
    "@kayahr/text-encoding": "2.2.0",
    "@tauri-apps/api": "2.12.4",
    "jszip": "3.10.1",
    "lucide-react": "1.67.0",
    "opencc-js": "1.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.2.1",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.5.0",
    "jsdom": "30.1.3",
    "tailwindcss": "4.3.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
